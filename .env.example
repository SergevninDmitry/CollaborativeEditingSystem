SERVICE_HOST=0.0.0.0

# External ports (docker-compose)
API_GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8004
USER_SERVICE_PORT=8003
DOCUMENT_SERVICE_PORT=8002
VERSION_SERVICE_PORT=8001
STREAMLIT_PORT=8501

POSTGRES_DB=collab_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

# Internal docker network connection
DATABASE_URL=postgresql+asyncpg://postgres:change_me@db:5432/collab_db

JWT_SECRET_KEY=change_this_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Used for service-to-service communication
INTERNAL_SERVICE_TOKEN=change_internal_token

API_URL=http://api_gateway:${API_GATEWAY_PORT}

AUTH_SERVICE_URL=http://auth_service:${AUTH_SERVICE_PORT}
USER_SERVICE_URL=http://user_service:${USER_SERVICE_PORT}
DOCUMENT_SERVICE_URL=http://document_service:${DOCUMENT_SERVICE_PORT}
VERSION_SERVICE_URL=http://version_service:${VERSION_SERVICE_PORT}
